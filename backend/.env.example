# Tümünün lokal bir varsayılanı vardır; .env olmadan da proje ayağa kalkar
# (PostgreSQL'in çalışıyor olması gerekir: docker compose up -d db).

# development | test | production. Tanınmayan her değer ÜRETİM sayılır.
# Üretimde aşağıdaki sırlar zorunludur, yoksa uygulama başlamaz.
APP_ENV=development

# PostgreSQL. Lokal: docker compose up -d db (bu adres varsayılandır).
# Üretimde zorunludur; postgres://… adresleri de kabul edilir.
DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora

# Üretimde en az 32 karakter, rastgele. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=lokal-gelistirme-anahtari
PHONE_HASH_SECRET=lokal-telefon-hash-anahtari
# /api/cron/sweep için X-Cron-Secret başlığı. Boşsa uç yalnızca MANAGER+ oturumla çalışır.
CRON_SECRET=

# Salonun saat dilimi; sunucu UTC'de çalışsa da randevu saatleri kaymaz.
APP_TIMEZONE=Europe/Istanbul

SLOT_LOCK_TTL_SECONDS=300
SLOT_GRID_MINUTES=15
# console: mesajlar log'a yazılır | evolution: WhatsApp (Evolution API, QR ile bağlı numara)
NOTIFICATION_DRIVER=console
# NOTIFICATION_DRIVER=evolution iken zorunlu (lokal: docker compose --profile whatsapp up -d)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=aurora-lokal-evolution-anahtari
EVOLUTION_INSTANCE=aurora
# Gelen mesajlar (ilk mesajda karşılama): Evolution'ın backend'e ulaştığı adres.
# Lokal Docker: http://host.docker.internal:8000 · Üretim: iç ağ adresi (ör. http://api:8000)
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8000
# Üretimde en az 32 karakter, rastgele.
EVOLUTION_WEBHOOK_SECRET=lokal-webhook-anahtari
# Müşteriye giden bağlantılar (karşılama mesajındaki {link}).
PUBLIC_SITE_URL=http://localhost:3000
# Kuyruk mesajları arası bekleme (ms) ve bakım başına en fazla mesaj.
# Hızlı/toplu gönderim numaranın WhatsApp tarafından kısıtlanma riskini artırır.
WHATSAPP_SEND_INTERVAL_MS=1500
NOTIFICATION_BATCH_SIZE=20
# Hatırlatma kuyruğunu uygulama içinde kaç saniyede bir kontrol et (0 = kapalı).
NOTIFICATION_POLL_SECONDS=60
# Yalnızca geliştirmede; üretimde tanımlıysa uygulama başlamaz.
DEV_OTP_CODE=123456
UPLOAD_DIR=./uploads

# API'ye tarayıcıdan DOĞRUDAN erişilecekse izinli origin'ler (virgülle).
# Next.js rewrite üzerinden erişimde gerekmez.
# CORS_ORIGINS=https://salon.example.com
